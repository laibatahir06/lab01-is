# Function to encrypt the plaintext
def encrypt(plaintext, keyword):
    ciphertext = ""
    key_index = 0

    # Convert keyword to lowercase
    keyword = keyword.lower()

    # Process every character in the plaintext
    for char in plaintext:

        # Only encrypt alphabetic characters
        if char.isalpha():

            # Calculate the shift using the keyword
            shift = ord(keyword[key_index % len(keyword)]) - ord('a')

            # Keep uppercase letters uppercase
            if char.isupper():
                encrypted_char = chr(
                    (ord(char) - ord('A') + shift) % 26 + ord('A')
                )

            # Encrypt lowercase letters
            else:
                encrypted_char = chr(
                    (ord(char) - ord('a') + shift) % 26 + ord('a')
                )

            # Add encrypted character
            ciphertext += encrypted_char

            # Move to the next keyword character
            key_index += 1

        # Keep spaces and punctuation unchanged
        else:
            ciphertext += char

    return ciphertext


# Function to decrypt the ciphertext
def decrypt(ciphertext, keyword):
    plaintext = ""
    key_index = 0

    keyword = keyword.lower()

    # Process every character in the ciphertext
    for char in ciphertext:

        # Only decrypt alphabetic characters
        if char.isalpha():

            # Calculate the shift using the keyword
            shift = ord(keyword[key_index % len(keyword)]) - ord('a')

            # Keep uppercase letters uppercase
            if char.isupper():
                decrypted_char = chr(
                    (ord(char) - ord('A') - shift) % 26 + ord('A')
                )

            # Decrypt lowercase letters
            else:
                decrypted_char = chr(
                    (ord(char) - ord('a') - shift) % 26 + ord('a')
                )

            # Add decrypted character
            plaintext += decrypted_char

            # Move to the next keyword character
            key_index += 1

        # Keep spaces and punctuation unchanged
        else:
            plaintext += char

    return plaintext


# Get plaintext from the user
plaintext = input("Enter plaintext: ")

# Get keyword from the user
keyword = input("Enter keyword: ")

# Encrypt the plaintext
ciphertext = encrypt(plaintext, keyword)

# Decrypt the ciphertext
decrypted_text = decrypt(ciphertext, keyword)

# Display the results
print("\nEncrypted text:", ciphertext)
print("Decrypted text:", decrypted_text)
